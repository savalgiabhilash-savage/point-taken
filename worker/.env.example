# Copy to worker/.env and fill in from Supabase -> Project Settings -> API.
# The service-role key is a SECRET (server-side only) — never commit it, never expose it to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Your FPL entry (team) ID — for the team sync + optimizer (Phase 5/6).
FPL_ENTRY_ID=your-entry-id

# Anthropic API key for the news/sentiment classifier (Phase 7). SECRET — never commit.
# Used by `python -m fpl_worker.news_job`. Without it, only that job is unavailable.
ANTHROPIC_API_KEY=paste-your-full-key-here-including-the-sk-ant-prefix
